        </mxCell>
        <mxCell id="work-card1-body" value="Cada revisión se asigna a una línea según la&#xa;clasificación del vehículo. Una línea de inspección&#xa;no equivale a un hilo." style="text;html=0;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#15304A;lineHeight=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="886" width="474" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="work-card1-source" value="Requisitos: RF-10 y RF-11." style="text;html=0;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=15;fontColor=#52677A;" vertex="1" parent="1">
          <mxGeometry x="60" y="985" width="474" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="work-card2-title" value="2   LÍNEAS SIMULTÁNEAS" style="text;html=0;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=19;fontStyle=1;fontColor=#087E82;" vertex="1" parent="1">
          <mxGeometry x="603" y="844" width="474" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="work-card2-body" value="X e Y pueden revisarse en líneas distintas al mismo&#xa;tiempo. Es concurrencia operativa requerida, no&#xa;una prueba de paralelismo de CPU." style="text;html=0;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#15304A;lineHeight=1.5;" vertex="1" parent="1">
          <mxGeometry x="603" y="886" width="474" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="work-card2-source" value="Requisito: RNF-08; sin medición aportada." style="text;html=0;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=15;fontColor=#52677A;" vertex="1" parent="1">
          <mxGeometry x="603" y="985" width="474" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="work-card3-title" value="3   COORDINACIÓN Y RESULTADO" style="text;html=0;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=19;fontStyle=1;fontColor=#94600B;" vertex="1" parent="1">
          <mxGeometry x="1146" y="844" width="474" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="work-card3-body" value="Cada vehículo espera a completar su etapa. El&#xa;backend reúne sus pruebas; aprobar y pagar habilita&#xa;el certificado." style="text;html=0;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#15304A;lineHeight=1.5;" vertex="1" parent="1">
