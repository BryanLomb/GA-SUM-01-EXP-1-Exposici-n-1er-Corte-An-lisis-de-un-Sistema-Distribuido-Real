        <mxCell id="work-card1-title" value="1   REPARTO POR VEHÍCULO" style="text;html=0;strokeColor=none;fillColor=none;align=left;fontFamily=Helvetica;fontSize=19;fontStyle=1;fontColor=#2469A0;" vertex="1" parent="1">
